      "tour_start": {
        "default": "mdi:calendar-start"
      },
      "tour_end": {
        "default": "mdi:calendar-end"
      }
    },
    "text": {
      "travel_cost_note": {
        "default": "mdi:note-text-outline"
      },
      "tour_title": {
        "default": "mdi:format-title"
      }
    },
    "date": {
      "travel_cost_date": {
        "default": "mdi:calendar"
      }
    }
  },
  "services": {
    "exportieren": {
      "service": "mdi:export"
    },
    "aufraeumen": {
      "service": "mdi:delete-sweep"
    },
    "reise_starten": {
      "service": "mdi:play"
    },
    "reise_beenden": {
      "service": "mdi:stop"
    },
    "fahrtenbuch_eintragen": {
      "service": "mdi:notebook-plus"
    },
    "fahrtenbuch_speichern": {
      "service": "mdi:notebook-check"
    },
    "fahrtenbuch_aendern": {
      "service": "mdi:notebook-edit"
    },
    "fahrtenbuch_loeschen": {
      "service": "mdi:notebook-remove"
    },
    "fahrtenbuch_csv": {
