    },
    "fahrtenbuch_nachtragen": {
      "service": "mdi:notebook-clock"
    },
    "reisekosten_eintragen": {
      "service": "mdi:cash-plus"
    },
    "reisekosten_aendern": {
      "service": "mdi:cash-edit"
    },
    "reisekosten_loeschen": {
      "service": "mdi:cash-remove"
    },
    "keine_maut": {
