{
  "options": {
    "step": {
      "init": {
        "sections": {
          "detection": "mdi:car-clock",
          "export": "mdi:image-multiple",
          "thresholds": "mdi:tune-variant",
          "logbook": "mdi:notebook-edit"
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "trip_active": {
        "default": "mdi:rv-truck",
        "state": {
          "off": "mdi:parking"
        }
      }
    },
    "image": {
      "last_trip_composite": {
        "default": "mdi:map-marker-path"
      }
    },
    "select": {
      "export_choice": {
        "default": "mdi:folder-multiple-image"
      }
    },
    "sensor": {
      "trip_status": {
        "default": "mdi:map-clock",
        "state": {
          "bereit": "mdi:parking",
          "unterwegs": "mdi:rv-truck",
          "pause": "mdi:pause-circle",
          "auswertung": "mdi:cog-sync",
          "zusammenfuehrbar": "mdi:timer-sand",
          "fehler": "mdi:alert-circle"
        }
      },
      "trip_start": {
        "default": "mdi:flag-variant"
      },
      "trip_distance": {
        "default": "mdi:map-marker-distance"
      },
      "trip_driving_time": {
        "default": "mdi:steering"
      },
      "last_trip_title": {
        "default": "mdi:map-legend"
      },
      "last_trip_distance": {
        "default": "mdi:map-marker-distance"
      },
      "last_trip_driving_time": {
        "default": "mdi:steering"
      },
      "last_trip_duration": {
        "default": "mdi:timer-outline"
      },
      "last_trip_end": {
        "default": "mdi:flag-checkered"
      },
      "trip_pause_time": {
        "default": "mdi:coffee"
      },
      "trip_average_speed": {
        "default": "mdi:speedometer-medium"
      },
      "logbook_entry": {
        "default": "mdi:notebook-check",
        "state": {
          "offen": "mdi:notebook-edit"
        }
      },
      "odometer": {
        "default": "mdi:counter"
      },
      "fuel_level": {
        "default": "mdi:gas-station"
      },
      "gas_1_level": {
        "default": "mdi:propane-tank"
      },
      "gas_2_level": {
        "default": "mdi:propane-tank"
      },
      "average_consumption": {
        "default": "mdi:fuel"
      },
      "costs_month": {
        "default": "mdi:cash-multiple"
      },
      "costs_year": {
        "default": "mdi:cash-multiple"
      }
    },
    "number": {
      "logbook_odometer": {
        "default": "mdi:counter"
      },
      "logbook_fuel": {
        "default": "mdi:gas-station"
      },
      "logbook_gas_1": {
        "default": "mdi:propane-tank"
      },
      "logbook_gas_2": {
        "default": "mdi:propane-tank"
      },
      "logbook_fuel_litres": {
        "default": "mdi:fuel"
      },
      "logbook_fuel_amount": {
        "default": "mdi:cash"
      },
      "logbook_gas_litres": {
        "default": "mdi:propane-tank-outline"
      },
      "logbook_gas_amount": {
        "default": "mdi:cash"
      }
    },
    "button": {
      "logbook_save": {
        "default": "mdi:content-save"
      },
      "logbook_discard": {
        "default": "mdi:close-circle-outline"
      }
    }
  },
  "services": {
    "exportieren": {
      "service": "mdi:export"
    },
    "aufraeumen": {
      "service": "mdi:delete-sweep"
    },
    "reise_starten": {
      "service": "mdi:play"
    },
    "reise_beenden": {
      "service": "mdi:stop"
    },
    "fahrtenbuch_eintragen": {
      "service": "mdi:notebook-plus"
    },
    "fahrtenbuch_aendern": {
      "service": "mdi:notebook-edit"
    },
    "fahrtenbuch_loeschen": {
      "service": "mdi:notebook-remove"
    },
    "fahrtenbuch_csv": {
      "service": "mdi:file-delimited"
    }
  }
}
